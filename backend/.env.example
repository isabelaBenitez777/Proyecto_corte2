# ============================================================
# Variables de entorno para el backend FastAPI
# Copia este archivo como .env y completa los valores
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJ_TU_SERVICE_ROLE_KEY

# ---- Dispositivo ESP32 ----
# UUID del dispositivo en la tabla 'devices' de Supabase.
# El backend buscará la IP del ESP32 automáticamente en device_status.
# Si no la encuentra, usará ESP32_FALLBACK_IP.
DEVICE_ID=pon-aqui-el-uuid-de-tu-dispositivo
ESP32_FALLBACK_IP=192.168.1.100

# ---- Email (Gmail con App Password) ----
# Para generar App Password: Google Account → Seguridad → Contraseñas de aplicaciones
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_EMAIL=correo_destino@gmail.com

# ---- Detección de movimiento ----
# % del frame cubierto por zonas en movimiento para disparar (más bajo = más sensible)
DETECTION_THRESHOLD=2.0
# Diferencia de brillo (0-255) para considerar un píxel cambiado
PIXEL_THRESHOLD=25
# % mínimo del frame que debe ocupar una zona para contar (filtra ruido)
MIN_BLOB_AREA=0.3
# Similitud estructural mínima con el fondo (0-1); por debajo = objeto muy cerca o cámara tapada
SCENE_CHANGE_THRESHOLD=0.6
# Frames quietos seguidos tras un cambio para aceptarlo como nuevo fondo
STALE_SCENE_FRAMES=15
COOLDOWN_SECONDS=30

# ---- Horario de vigilancia (formato HH:MM, 24h) ----
# Solo se disparan alarmas dentro de este rango.
# Para vigilar siempre: START=00:00, END=23:59
SCHEDULE_START=00:00
SCHEDULE_END=23:59
